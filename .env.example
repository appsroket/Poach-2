# ---------------------------------------------------------------------------
# Poach environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key (safe for the browser, RLS-enforced):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key (SERVER ONLY — used in cron & privileged routes,
# bypasses RLS; never expose to the client):
SUPABASE_SERVICE_ROLE_KEY=

# --- AI --------------------------------------------------------------------
# Anthropic Console → API Keys (resume parse, tailored resume/cover letter,
# outreach, match reasons):
ANTHROPIC_API_KEY=
# OpenAI Platform → API Keys (text-embedding-3-small for pgvector matching):
OPENAI_API_KEY=

# --- Payments (Stripe) -----------------------------------------------------
# Stripe Dashboard → Developers → API keys (secret key):
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → signing secret for your endpoint:
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard → Products → your Pro price → API ID (price_...):
NEXT_PUBLIC_STRIPE_PRICE_ID=

# --- Email (Resend) --------------------------------------------------------
# Resend Dashboard → API Keys (alerts, digests, outreach sends):
RESEND_API_KEY=

# --- Cron / internal -------------------------------------------------------
# Any strong random string; must match the secret you set on Vercel Cron so
# /api/cron/* can authenticate scheduled invocations:
CRON_SECRET=

# --- Landing lead webhook --------------------------------------------------
# GoHighLevel / Make inbound webhook URL that /api/lead forwards captures to:
WEBHOOK_URL=

# --- Contact enrichment ----------------------------------------------------
# Hunter.io → Dashboard → API (v2) key for hiring-manager email lookup:
HUNTER_API_KEY=
